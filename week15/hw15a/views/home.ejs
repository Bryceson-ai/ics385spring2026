<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HW15-A Google OAuth Demo</title>
    <style>
      body { font-family: Arial, sans-serif; margin: 0; background: #f4f6f8; color: #1f2937; }
      main { min-height: 100vh; display: grid; place-items: center; padding: 16px; }
      .card { width: 100%; max-width: 500px; background: #fff; border-radius: 12px; padding: 24px; box-shadow: 0 8px 20px rgba(0,0,0,0.08); text-align: center; }
      h1 { margin-top: 0; color: #0f766e; }
      a.button { display: inline-block; margin-top: 12px; padding: 12px 18px; border-radius: 8px; background: #0f766e; color: #fff; text-decoration: none; font-weight: 700; }
      a.button:hover { background: #115e59; }
      .meta { color: #4b5563; }
    </style>
  </head>
  <body>
    <main>
      <section class="card">
        <h1>Week 15A: Sign in with Google</h1>
        <p class="meta">Standalone OAuth demo using Passport Google strategy.</p>

        <% if (user) { %>
          <p>You are signed in as <strong><%= user.email %></strong>.</p>
          <a class="button" href="/profile">Go to Profile</a>
        <% } else { %>
          <a class="button" href="/auth/google">Sign in with Google</a>
        <% } %>
      </section>
    </main>
  </body>
</html>
