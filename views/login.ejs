<!doctype html>
<html lang="en">
  <head>
    <%- include('partials-head') %>
  </head>
  <body class="auth-page">
    <main class="auth-shell">
      <section class="auth-card panel">
        <p class="eyebrow">Admin access</p>
        <h1>Sign in</h1>
        <p class="muted">Use local credentials or Google OAuth to access protected admin routes.</p>

        <% if (authError) { %>
          <div class="alert"><%= authError %></div>
        <% } %>

        <% if (errors && errors.length) { %>
          <div class="alert">
            <% errors.forEach((error) => { %>
              <p><%= error.msg %></p>
            <% }) %>
          </div>
        <% } %>

        <% if (googleEnabled) { %>
          <a class="button button-google" href="/auth/google">Sign in with Google</a>
          <div class="divider"><span>or sign in with email</span></div>
        <% } %>

        <form method="post" action="/login" class="auth-form">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" value="<%= formData.email || '' %>" required />

          <label for="password">Password</label>
          <input id="password" name="password" type="password" required />

          <button class="button button-primary" type="submit">Sign In</button>
        </form>

        <p class="auth-footer">Need an account? <a href="/register">Create one</a></p>
      </section>
    </main>
  </body>
</html>
